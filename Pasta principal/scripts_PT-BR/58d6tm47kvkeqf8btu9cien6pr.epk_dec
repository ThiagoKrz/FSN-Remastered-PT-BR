DAT
id=qid::label=str::text=lstr::
41088::$$$message_0356_0000_0000$$$::"..."[lr]::
41089::$$$message_0356_0000_0001$$$::Contenho meu corpo, que quer saltar para fora.[lr]::
41090::$$$message_0356_0000_0002$$$::Vejo Tohsaka mordendo os lábios pelo canto do olho.::
41091::$$$message_0356_0001_0000$$$::...Eu sei.[lr]::
41092::$$$message_0356_0001_0001$$$::É óbvio que Tohsaka também quer detê-lo.[lr]::
41093::$$$message_0356_0001_0002$$$::Mas seremos nós os mortos se fizermos isso.[lr]::
41094::$$$message_0356_0001_0003$$$::Não há como detê-lo.::
41095::$$$message_0356_0002_0000$$$::                          O braço do homem se estende até a garota de branco.::
41096::$$$message_0356_0003_0000$$$::"..., ..., ..."[lr]::
41097::$$$message_0356_0003_0001$$$::Não consigo respirar.[lr]::
41098::$$$message_0356_0003_0002$$$::Meus pés estão em chamas de tanta vontade de saltar,[lr]::
41099::$$$message_0356_0003_0003$$$::e meus braços querem se lançar sobre o terraço.[lr]::
41100::$$$message_0356_0003_0004$$$::Meu corpo... Meu corpo treme como se estivesse quebrado e tenta ir contra as ordens do meu cérebro.::
41101::$$$message_0356_0004_0000$$$::                                      É como se meu coração estivesse estilhaçado.::
41102::$$$message_0356_0005_0000$$$::"..., ..., ..."[lr]::
41103::$$$message_0356_0005_0001$$$::Mesmo assim, sufoco minha voz e mato minha vontade.[lr]::
41104::$$$message_0356_0005_0002$$$::Deixo a garota morrer como se matasse a mim mesmo.::
41105::$$$message_0356_0006_0000$$$::[font italic=true]...[font italic=false][lr]::
41106::$$$message_0356_0006_0001$$$::E tudo termina.[lr]::
41107::$$$message_0356_0006_0002$$$::O homem arrancou algo do corpo da garota com as mãos nuas, ainda com um sorriso no rosto.[lr]::
41108::$$$message_0356_0006_0003$$$::Um objeto vermelho e gotejante que parece uma fruta.[lr]::
41109::$$$message_0356_0006_0004$$$::A coisa na mão do homem é, sem dúvida, o ----- da garota de branco.::
41110::$$$message_0356_0007_0000$$$::[font italic=true]...[font italic=false][lr]::
41111::$$$message_0356_0007_0001$$$::Minha mente incendeia.[lr]::
41112::$$$message_0356_0007_0002$$$::A mente que ficou branca faz meu corpo inteiro tremer de uma raiva incontrolável.::
41113::$$$message_0356_0008_0000$$$::"Oh? Eu vinha sentindo um cheiro ruim, mas entendo. Havia um canalha bisbilhotando, hein?"[lr]::
41114::$$$message_0356_0008_0001$$$::O homem, ainda segurando a coisa vermelha na mão direita...[lr]::
41115::$$$message_0356_0008_0002$$$::"Que insolência. Um mero vira-lata não deveria olhar diretamente para mim...!"[lr]::
41116::$$$message_0356_0008_0003$$$::Ele dispara um de seus incontáveis Fantasmas Nobres contra mim.::

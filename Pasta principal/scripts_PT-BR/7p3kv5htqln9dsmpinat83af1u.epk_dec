DAT
id=qid::label=str::text=lstr::
71732::$$$message_0659_0000_0000$$$::"[w l=4][line4], [w l=4][line4], [w l=4][line4]"[lr]::
71733::$$$message_0659_0000_0001$$$::Minha consciência se desconecta.::
71734::$$$message_0659_0001_0000$$$::"[w l=4][line4], [w l=4][line4], [w l=4][line4]"[lr]::
71735::$$$message_0659_0001_0001$$$::É só uma questão de tempo até a caverna desabar.[lr]::
71736::$$$message_0659_0001_0002$$$::O teto desaba em vários pontos, e o chão, que antes parecia uma terra desolada, está virando uma montanha de escombros.::
71737::$$$message_0659_0002_0000$$$::"[w l=4][line4], [w l=4][line4], [w l=4][line4]"[lr]::
71738::$$$message_0659_0002_0001$$$::Minhas juntas estão rígidas.[lr]::
71739::$$$message_0659_0002_0002$$$::Dói dobrar os braços e as pernas.[lr]::
71740::$$$message_0659_0002_0003$$$::Meus nervos queimam.[lr]::
71741::$$$message_0659_0002_0004$$$::Centenas de lâminas brotam de dentro do meu corpo.[lr]::
71742::$$$message_0659_0002_0005$$$::Uma execução por empalamento sem escapatória.[lr]::
71743::$$$message_0659_0002_0006$$$::Meu corpo é feito de espadas.[lr]::
71744::$$$message_0659_0002_0007$$$::Eu já sabia disso.[lr]::
71745::$$$message_0659_0002_0008$$$::A bomba-relógio foi acionada quando eu usei projeção.[lr]::
71746::$$$message_0659_0002_0009$$$::Esse fim já estava decidido há muito tempo.::
71747::$$$message_0659_0003_0000$$$::"[w l=4][line4]Ha, ah[w l=4][line4]!"[lr]::
71748::$$$message_0659_0003_0001$$$::Vou quebrar.[lr]::
71749::$$$message_0659_0003_0002$$$::Se eu continuar, vou quebrar.[lr]::
71750::$$$message_0659_0003_0003$$$::Vou me despedaçar e acabar igual às pedras espalhadas por aí.::
71751::$$$message_0659_0004_0000$$$::...Mas ainda dá tempo.[lr]::
71752::$$$message_0659_0004_0001$$$::Este corpo já não tem salvação, mas, se eu parar aqui, ainda consigo passar mais ou menos um dia sem perder o sentido.::
71753::$$$message_0659_0005_0000$$$::Só mais um dia de vida.[lr]::
71754::$$$message_0659_0005_0001$$$::Agora, eu desejo desesperadamente até uma coisa tão insignificante assim.[lr]::
71755::$$$message_0659_0005_0002$$$::Só um dia. Uma hora ou até um minuto.[lr]::
71756::$$$message_0659_0005_0003$$$::Se eu conseguir viver, eu quero ficar aqui o máximo possível, não importa o quão miserável seja.::
71757::$$$message_0659_0006_0000$$$::"Haa, gu[w l=4][line4]......!"[lr]::
71758::$$$message_0659_0006_0001$$$::Uma rachadura.[lr]::
71759::$$$message_0659_0006_0002$$$::Não por fora, mas por dentro. O núcleo accumbens do cérebro rachou.[lr]::
71760::$$$message_0659_0006_0003$$$::A parte que rege o que me leva a agir, ou seja, a ligação com o prazer.[lr]::
71761::$$$message_0659_0006_0004$$$::A parte mais importante para 'viver'. Viver é buscar prazer. Sem isso, um ser humano não passa de uma fera.::
71762::$$$message_0659_0007_0000$$$::"Haa, ah."[lr]::
71763::$$$message_0659_0007_0001$$$::Não foi tão conveniente assim.[lr]::
71764::$$$message_0659_0007_0002$$$::Mesmo assim, ainda desejo isso.[lr]::
71765::$$$message_0659_0007_0003$$$::Estou tão apegado a continuar sendo eu mesmo que chego a morder os próprios dedos.[lr]::
71766::$$$message_0659_0007_0004$$$::Mesmo assim, continuo me quebrando.[lr]::
71767::$$$message_0659_0007_0005$$$::Nem a dor de morder os dedos da mão direita consegue impedir minhas memórias de desaparecer.::
71768::$$$message_0659_0008_0000$$$::A cada passo, eu desapareço.[lr]::
71769::$$$message_0659_0008_0001$$$::Eu não vou conseguir.[lr]::
71770::$$$message_0659_0008_0002$$$::Desse jeito, vou acabar esquecendo quem sou e o que tenho que fazer.[lr]::
71771::$$$message_0659_0008_0003$$$::Então eu deveria parar aqui e esperar por[w l=4][line4]::
71772::$$$message_0659_0009_0000$$$::"[w l=4][line4]Sim, eu me lembro."[lr]::
71773::$$$message_0659_0009_0001$$$::Mas... alguma coisa.[lr]::
71774::$$$message_0659_0009_0002$$$::Uma razão maior, fora do meu corpo.[lr]::
71775::$$$message_0659_0009_0003$$$::"Sakura[w l=4][line4]vamos ver as flores."[lr]::
71776::$$$message_0659_0009_0004$$$::Você precisa cumprir o seu papel.::
71777::$$$message_0659_0010_0000$$$::[w l=4][line4]O tempo parou.[lr]::
71778::$$$message_0659_0010_0001$$$::Não há dor.[lr]::
71779::$$$message_0659_0010_0002$$$::Um único passo leva um dia inteiro.::
71780::$$$message_0659_0010_0003$$$::[w l=4][line4]Esqueci como respirar.[lr]::
71781::$$$message_0659_0010_0004$$$::Não há dor.[lr]::
71782::$$$message_0659_0010_0005$$$::Nem em um dia inteiro consigo puxar uma única lufada de ar.::
71783::$$$message_0659_0010_0006$$$::[w l=4][line4]Perdi o sentido.[lr]::
71784::$$$message_0659_0010_0007$$$::O que era dor?[lr]::
71785::$$$message_0659_0010_0008$$$::O orgânico virou inorgânico.::
71786::$$$message_0659_0010_0009$$$::Consegui me segurar.[lr]::
71787::$$$message_0659_0010_0010$$$::Enquanto caía, estendi a mão e agarrei a parede.[lr]::
71788::$$$message_0659_0010_0011$$$::É minúsculo. Toda a minha existência se sustenta num apoio do tamanho da ponta de uma unha.[lr]::
71789::$$$message_0659_0010_0012$$$::Não tem como isso aguentar.[lr]::
71790::$$$message_0659_0010_0013$$$::O apoio desmorona e::
71791::$$$message_0659_0011_0000$$$::O princípio que rege minhas ações se perde.[lr]::
71792::$$$message_0659_0011_0001$$$::O motivo para agir se perde.[lr]::
71793::$$$message_0659_0011_0002$$$::O sentido de existir se perde.[lr]::
71794::$$$message_0659_0011_0003$$$::Eu não sinto medo.[lr]::
71795::$$$message_0659_0011_0004$$$::Perco a noção de para quê e por quem existo.::
71796::$$$message_0659_0012_0000$$$::Já faz tempo que eu não estou mais vivo.[lr]::
71797::$$$message_0659_0012_0001$$$::Não existe razão alguma capaz de fazer esse braço se mover.::
71798::$$$message_0659_0013_0000$$$::"[w l=4][line4]Trace,"[lr]::
71799::$$$message_0659_0013_0001$$$::Palavras saem da minha boca.[lr]::
71800::$$$message_0659_0013_0002$$$::Mesmo depois de perder não só a área da linguagem, mas todo o neocórtex e até o restante do cérebro, incluindo as outras três regiões, ainda restava alguma coisa.::
71801::$$$message_0659_0014_0000$$$::"[w l=4][line4]on."[lr]::
71802::$$$message_0659_0014_0001$$$::O corpo morreu.[lr]::
71803::$$$message_0659_0014_0002$$$::Mas a alma ainda permanece aqui.::
71804::$$$message_0659_0015_0000$$$::Teço os oito versos.[lr]::
71805::$$$message_0659_0015_0001$$$::A sobrecarga se estende do corpo à alma e, além disso, o sentido[lr]::
71806::$$$message_0659_0015_0002$$$::"[w l=8][line8]Ah."[lr]::
71807::$$$message_0659_0015_0003$$$::E assim, Emiya Shirou morreu.[lr]::
71808::$$$message_0659_0015_0004$$$::A figura parada não é diferente de uma máquina.[lr]::
71809::$$$message_0659_0015_0005$$$::Ainda tem a função de erguer a espada que criou, mas, sem vontade para se mover, não passa de destroços.::
71810::$$$message_0659_0016_0000$$$::Mas mesmo sem inteligência artificial...[lr]::
71811::$$$message_0659_0016_0001$$$::Neste mundo, existem muitas máquinas que tecem sonhos.::
71812::$$$message_0659_0017_0000$$$::Havia uma promessa.[lr]::
71813::$$$message_0659_0017_0001$$$::Um dia, quando o inverno passar e a primavera chegar[w l=4][line4]::
71814::$$$message_0659_0018_0000$$$::Uma sequência de caracteres cujo significado eu já nem entendo.[lr]::
71815::$$$message_0659_0018_0001$$$::Uma pequena esperança, lembrada até o fim, que precisava ser cumprida.::

id=qid::label=str::text=lstr::
77026::$$$message_0715_0000_0000$$$::Sonho numa caixa de criação de insetos.[lr]::
77027::$$$message_0715_0000_0001$$$::Um ninho em ruínas.[lr]::
77028::$$$message_0715_0000_0002$$$::Uma pupa negra.[lr]::
77029::$$$message_0715_0000_0003$$$::Não tenho lembranças do meu nascimento.[lr]::
77030::$$$message_0715_0000_0004$$$::Eu cresço e prospero.[lr]::
77031::$$$message_0715_0000_0005$$$::Minhas origens são desconhecidas desde o princípio.[lr]::
77032::$$$message_0715_0000_0006$$$::Não tenho lembranças do dia da minha morte.::
77033::$$$message_0715_0001_0000$$$::                                     Caminho a passos regulares.[lr]::
77034::$$$message_0715_0001_0001$$$::                                     Minha cabeça vazia balança de um lado para o outro,[lr]::
77035::$$$message_0715_0001_0002$$$::                                     sem um destino certo.::
77036::$$$message_0715_0001_0003$$$::                               Arrepio e tremo. Vamos, vamos![lr]::
77037::$$$message_0715_0001_0004$$$::                               Minhas mãos e meus pés secos chacoalham como balões de papel,[lr]::
77038::$$$message_0715_0001_0005$$$::                               rolando pelo chão.[lr]::
77039::$$$message_0715_0001_0006$$$::                                          Só vou poder flutuar quando crescer.::
77040::$$$message_0715_0001_0007$$$::                                                               Vamos, vamos.[lr]::
77041::$$$message_0715_0001_0008$$$::                                                               Vamos, vamos.[lr]::
77042::$$$message_0715_0001_0009$$$::                                                               Vamos, vamos.::
77043::$$$message_0715_0001_0010$$$::"Ei, olha[line4]aquela[line2]você[line2]o que acha?"[lr]::
77044::$$$message_0715_0001_0011$$$::                               Alguém se aproxima, com uma voz esganiçada.[lr]::
77045::$$$message_0715_0001_0012$$$::"Opa, que gata. [line6]descalça? Droga[line4][r]pálida[line16]"[lr]::
77046::$$$message_0715_0001_0013$$$::                               As pessoas vêm se juntando ao meu redor.[lr]::
77047::$$$message_0715_0001_0014$$$::"[line8]né? [line4]vem com a gente[line6]matar o tempo?"::
77048::$$$message_0715_0001_0015$$$::                                      Risadas vazias.[lr]::
77049::$$$message_0715_0001_0016$$$::                                      Não me lembro de tê-los chamado.[lr]::
77050::$$$message_0715_0001_0017$$$::                                      Eles me dão medo. Hora de voltar para casa.::
77051::$$$message_0715_0001_0018$$$::"Ei[line2]aonde[line2]pensa que[line2]vai?"[lr]::
77052::$$$message_0715_0001_0019$$$::"Espera aí[line6]? Sua[line2]vadi[line1]!?"[lr]::
77053::$$$message_0715_0001_0020$$$::"Você não[line2]? Senão, por que[line1]sair[line2]andar[line2]pela cidade[line1]?"[lr]::
77054::$$$message_0715_0001_0021$$$::"Haha[line2]ha! É[line2]então[line2]a gente tem que[line2]proteger[line2]né?"[lr]::
77055::$$$message_0715_0001_0022$$$::"Concordo! [line2]adoro ajudar[line2]gente[line2]em apuros!"::
77056::$$$message_0715_0001_0023$$$::                                   "[line4]ha[line4]ha[line5]ha[line2]!"[lr]::
77057::$$$message_0715_0001_0024$$$::                                  "Ah[line4]ha[line3]hahaha[line6]!"[lr]::
77058::$$$message_0715_0001_0025$$$::                                "Ahahaha[line2]hahaha[line1]hahahahahahaha[line2]"[lr]::
77059::$$$message_0715_0001_0026$$$::                                    "Ahahahahahahahahahahahahahahaha!"::
77060::$$$message_0715_0001_0027$$$::                                      Eles continuam me perseguindo.[lr]::
77061::$$$message_0715_0001_0028$$$::                                      A gritaria estridente me dá dor de cabeça,[lr]::
77062::$$$message_0715_0001_0029$$$::                                      então minha barriga vazia ronca.::
77063::$$$message_0715_0001_0030$$$::"[line15]!?!?!?"[lr]::
77064::$$$message_0715_0001_0031$$$::"Pe[line4]pera[line3]o qu[line3]aaa[line1]!?"[lr]::
77065::$$$message_0715_0001_0032$$$::"A-Ah[line4]não foge, desgraçado, me aju[line2]daaa!"[lr]::
77066::$$$message_0715_0001_0033$$$::"Ha, ha, ha, o que... pra onde vocês[line4]::
77067::$$$message_0715_0001_0034$$$::AAAAAAAAAAH!"[lr]::
77068::$$$message_0715_0001_0035$$$::"N-não, d-desculpa, me desculpAAAAAAAH!?!?!?"::
77069::$$$message_0715_0002_0000$$$::Sonho com uma caixa de criação de insetos.::
77070::$$$message_0715_0003_0000$$$::Essa noite.[lr]::
77071::$$$message_0715_0003_0001$$$::Eu esmaguei um inseto.::


{
  "meta": {
    "nome": "Glossário Operacional Type-Moon do Fate Café",
    "escopo": "Padrão local do repositório para tradução, validação, recompilação e publicação de EPUBs e textos Type-Moon",
    "status": "ativo",
    "observacao": "Este arquivo é um glossário operacional local. Ele prioriza termos com maior risco de inconsistência em LLMs, inclui extensões específicas de Fate/Apocrypha e registra invariantes obrigatórios do pipeline. ATENÇÃO: O nome do homúnculo protagonista de Fate/Apocrypha é SIEG (ジーク), NUNCA Ziek. O nome correto da classe nunca traduzida é Ruler, nunca Governante ou afins.",
    "links_relevantes": {
      "guia_operacional": "standards/type-moon/README.md",
      "prompt_canonico": "standards/type-moon/PROMPT_TRADUCAO_TYPEMOON_EPUB.md",
      "script_prepare_workbench": "tools/novels/prepare-epub-workbench.ps1",
      "script_sync_traducao": "tools/novels/sync-epub-translation.ps1",
      "script_rebuild_epub": "tools/novels/rebuild-epub.ps1",
      "modulo_atual_do_site": "src/util/data/novels.ts"
    }
  },
  "regras": {
    "prioridade_maxima": "PRIORIDADE MÁXIMA. Se um termo estiver neste glossário, ele deve ser usado exatamente como está definido.",
    "conflito_prompt_vs_glossario": "Se houver conflito entre o prompt e o glossário, o glossário vence.",
    "conflito_workbench_vs_guia_central": "Se houver conflito entre um README local de workbench e a documentação central em standards/type-moon, a documentação central vence.",
    "nao_inventar_termos": "Se o termo não estiver no glossário, não invente uma padronização definitiva sem sinalizar a necessidade de atualização posterior.",
    "expansao_pre_traducao_obrigatoria": "Antes da primeira etapa traduzida de cada volume, a LLM deve procurar termos novos específicos da obra ou da Type-Moon que ainda não estejam neste glossário, padronizá-los com critério suficiente e registrar a decisão neste arquivo antes de seguir para a tradução.",
    "site_nao_pode_depender_do_workbench": "O runtime do site não pode depender de novel-workbench. O workbench é temporário e deve poder ser apagado sem quebrar a leitura publicada.",
    "classes_nunca_traduzir": [
      "Saber",
      "Lancer",
      "Archer",
      "Rider",
      "Caster",
      "Assassin",
      "AssasSin",
      "Berserker",
      "Ruler",
      "Avenger",
      "Moon Cancer",
      "Alter-Ego",
      "Foreigner",
      "Pretender",
      "Shielder",
      "Beast"
    ],
    "termos_vn_relacao_escolar_preservaveis": [
      "Senpai",
      "Kouhai",
      "kouhai"
    ],
    "nota_termos_vn_relacao_escolar": "Em visual novels e textos com dinamica escolar japonesa, termos como Senpai e Kouhai/kouhai podem permanecer em PT-BR quando soarem naturais no registro de VN. Nao force veterano, calouro ou colega de um ano abaixo se o termo original preservar melhor a voz e o contexto; adapte apenas quando a frase exigir clareza."
  },
  "diretrizes_operacionais": {
    "ordem_leitura_llm": [
      "standards/type-moon/GLOSSARIO_TYPEMOON_OPERACIONAL.json",
      "standards/type-moon/README.md",
      "standards/type-moon/PROMPT_TRADUCAO_TYPEMOON_EPUB.md"
    ],
    "pipeline_canonico_resumido": [
      "Preparar o workbench com tools/novels/prepare-epub-workbench.ps1.",
      "Inspecionar manifest.json, translated-html, plaintext, content.opf e toc.ncx antes de decidir as etapas.",
      "Mapear termos novos específicos da obra ou da Type-Moon e atualizar este glossário antes da primeira etapa traduzida.",
      "Traduzir por etapas, sempre com o glossário no topo da prioridade.",
      "Validar cada etapa antes de avançar.",
      "Sincronizar translated-html de volta ao package com tools/novels/sync-epub-translation.ps1.",
      "Normalizar o package para publicação em PT-BR.",
      "Recompilar o EPUB com tools/novels/rebuild-epub.ps1.",
      "Copiar o arquivo final *.ptbr-sample.epub para src/assets/...",
      "Validar a integração com o site e manter o runtime desacoplado do workbench."
    ],
    "contrato_de_publicacao_atual": {
      "runtime_do_site_deve_ler_apenas_assets_publicados": [
        "src/assets/<Autor>/<Pasta do volume>/cover.jpg",
        "src/assets/<Autor>/<Pasta do volume>/metadata.opf",
        "src/assets/<Autor>/<Pasta do volume>/*.ptbr-sample.epub"
      ],
      "modulo_central_de_descoberta_atual": "src/util/data/novels.ts",
      "nome_do_epub_traduzido": "Mesmo nome-base do EPUB de origem, com sufixo .ptbr-sample.epub",
      "distincao_metadata_vs_content_opf": "metadata.opf do asset alimenta o catálogo do site; package/content.opf alimenta o EPUB recompilado e precisa ser normalizado para leitura em PT-BR."
    },
    "normalizacao_minima_do_package_publicado_ptbr": [
      "Arquivos visíveis ao leitor com xml:lang=\"pt-BR\".",
      "package/content.opf com <dc:language>pt-BR</dc:language>.",
      "package/content.opf com page-progression-direction=\"ltr\" para leitura ocidental padrão.",
      "package/content.opf com primary-writing-mode=\"horizontal-lr\" para leitura ocidental padrão.",
      "package/toc.ncx traduzido quando o sumário for visível ao leitor.",
      "Páginas especiais como titlepage.xhtml, créditos, posfácio e colofão revisadas no pacote final."
    ],
    "validacoes_minimas_por_etapa": [
      "Buscar sobras de japonês no lote traduzido.",
      "Buscar termos sensíveis ainda crus, como Mestre, Servant, Holy Grail, Noble Phantasm, True Name e Command Spell.",
      "Validar parse XML/HTML dos arquivos alterados.",
      "Rodar git diff --check.",
      "Revisar se o glossário foi aplicado com contexto, e não por troca cega."
    ],
    "politica_de_expansao_do_glossario": {
      "quando_rodar": "Antes da primeira etapa traduzida de cada volume.",
      "fontes_minimas": [
        "manifest.json",
        "translation/plaintext/",
        "translation/translated-html/",
        "sumário visível",
        "títulos visíveis",
        "créditos e páginas especiais"
      ],
      "o_que_deve_entrar": [
        "termos específicos da obra",
        "termos específicos da Type-Moon",
        "facções, organizações, sistemas, habilidades, itens, locais, cargos, epítetos, títulos e convenções recorrentes com necessidade real de padronização"
      ],
      "o_que_nao_deve_entrar": [
        "palavras genéricas",
        "nomes sem necessidade de padronização",
        "termos sem chance real de recorrência ou sem impacto de consistência"
      ],
      "como_registrar": [
        "usar a seção geral quando o termo for amplo de Type-Moon",
        "usar a seção específica da obra quando o termo pertencer à novel em questão",
        "evitar duplicatas se o termo já existir no glossário"
      ],
      "regra_de_duvida": [
        "se houver base suficiente, padronizar antes da tradução",
        "se houver ambiguidade relevante, preservar provisoriamente o original e marcar como candidato a revisão"
      ]
    },
    "politica_de_descarte_do_workbench": [
      "novel-workbench/... é temporário e não pode virar dependência do runtime do site.",
      "Depois que todos os volumes de uma novel estiverem traduzidos, validados e publicados no site, o workbench pode ser excluído.",
      "Antes de excluir o workbench, confirmar que o EPUB final *.ptbr-sample.epub está em src/assets/... e que o site o enxerga corretamente.",
      "Se no futuro o projeto migrar para um modelo estritamente EPUB-only, essa mudança deve ser concentrada no módulo de descoberta de dados do frontend, não espalhada pela UI."
    ]
  },
